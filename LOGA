def main():
    parser = argparse.ArgumentParser(
        description="SOC Log Analyzer — detects threats in auth logs"
    )
    parser.add_argument("logfile", nargs="?", help="Path to auth.log (omit to use sample)")
    parser.add_argument("--json", action="store_true", help="Output JSON instead of text")
    parser.add_argument("--sample", action="store_true", help="Generate sample log and analyze it")
    args = parser.parse_args()

    if args.sample or not args.logfile:
        sample_path = Path("sample_auth.log")
        generate_sample_log(sample_path)
        log_path = sample_path
    else:
        log_path = Path(args.logfile)

    if not log_path.exists():
        print(f"Error: {log_path} not found.")
        return

    analyzer = LogAnalyzer()
    with log_path.open() as f:
        for line in f:
            analyzer.analyze_line(line)

    report = analyzer.report()

    if args.json:
        print(json.dumps(report, indent=2))
    else:
        print_report(report)


if __name__ == "__main__":
    main()
